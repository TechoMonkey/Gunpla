{
  "name": "gunpla-wars-host",
  "version": "0.1.0",
  "private": true,
  "description": "Host server and browser client for the Gunpla Wars tabletop game.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,client -c cyan,magenta \"tsx watch src/server/main.ts\" \"vite\"",
    "build": "vite build",
    "start": "vite build && tsx src/server/main.ts",
    "serve": "tsx src/server/main.ts",
    "check-data": "tsx src/server/checkData.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "express": "^5.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^3.0.0"
  }
}
